{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["WS_URL", "SIGNAL_AUTH_TOKEN"],
      "outputs": ["dist/**", ".output/**", "public/**", "../public/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "dev:ext": {
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "AI_PROVIDER",
        "ANTHROPIC_API_KEY",
        "OPENROUTER_API_KEY",
        "DEEPGRAM_API_KEY",
        "OCTAMEM_API_KEY",
        "DATABASE_URL",
        "SIGNAL_AUTH_TOKEN",
        "SIGNAL_AUTH_DISABLED"
      ]
    },
    "lint": {}
  }
}
